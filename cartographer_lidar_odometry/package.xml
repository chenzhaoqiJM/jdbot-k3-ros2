<?xml version="1.0"?>
<package format="3">
  <name>cartographer_lidar_odometry</name>
  <version>0.1.0</version>
  <description>Pure 2D LiDAR odometry using Cartographer's local trajectory builder only.</description>
  <maintainer email="zhaoqi.chen@spacemit.com">chenzhaoqi</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>cartographer</depend>
  <depend>cartographer_ros</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
